# 前端在构建时读取下面这些变量，全部可选。

# 数据服务地址。本地开发不用设，scripts/run-local.sh 会用 http://127.0.0.1:8010；
# GitHub Pages 发布时由工作流从仓库变量 API_BASE 注入。
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8010

# 站点部署在仓库子路径下时的前缀，例如 /smashing_A_stock。本地留空。
NEXT_PUBLIC_BASE_PATH=

# 站点绝对地址，只用于拼 OG 图链接。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 衡量 ID（G- 开头）。留空则完全不加载统计脚本。
NEXT_PUBLIC_GA_ID=
